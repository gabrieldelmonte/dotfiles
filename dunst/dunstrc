[global]
    monitor = 0
    follow = mouse

    width = 360
    height = 160
    origin = top-right
    offset = 12x44

    padding = 10
    horizontal_padding = 12
    text_icon_padding = 10

    frame_width = 2
    frame_color = "#7287fd"
    separator_color = frame
    separator_height = 1

    sort = yes
    idle_threshold = 120

    font = MartianMono Nerd Font Mono Bold 11
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    word_wrap = yes
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 24
    max_icon_size = 48
    enable_recursive_icon_lookup = true
    icon_theme = Yaru-blue

    sticky_history = yes
    history_length = 20
    show_age_threshold = 60

    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst

    corner_radius = 12
    gaps = false
    gap_size = 0

    force_xwayland = false
    force_xinerama = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#eff1f5e6"
    foreground = "#4c4f69"
    frame_color = "#7287fd"
    timeout = 5
    icon = dialog-information

[urgency_normal]
    background = "#eff1f5e6"
    foreground = "#4c4f69"
    frame_color = "#1e66f5"
    timeout = 10
    icon = dialog-information

[urgency_critical]
    background = "#eff1f5e6"
    foreground = "#4c4f69"
    frame_color = "#d20f39"
    timeout = 0
    icon = dialog-error
