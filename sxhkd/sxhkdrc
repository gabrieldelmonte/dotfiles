# ============================================================
#  sxhkdrc — Catppuccin Latte bspwm keybindings
# ============================================================
# Super + / (or \) shows these as a searchable cheat sheet (rofi/scripts/keybinds.py).
# Convention, read by that script:
#   ## Section          starts a group
#   # Description       directly above a binding describes it
# A binding without a description is still listed, with its command instead.

## Apps

# Terminal
super + Return
    alacritty

# Terminal (no Super needed, e.g. in a VM viewer)
ctrl + alt + t
    alacritty

# Floating terminal
super + shift + Return
    alacritty --class "floating-term,floating-term"

# App launcher
super + space
    rofi -show drun -show-icons

# Run a command
super + shift + space
    rofi -show run

# File manager
super + e
    nautilus --new-window

# Settings (GNOME Settings: Wi-Fi, Bluetooth, Sound, Printers…)
super + i
    env XDG_CURRENT_DESKTOP=GNOME gnome-control-center

# Screen layout (monitors, resolution)
super + shift + i
    arandr

# Refresh rate of a screen (arandr cannot set it)
super + shift + r
    ~/.config/rofi/scripts/refreshrate.py

# Keybinding cheat sheet (this list)
super + {slash,backslash}
    ~/.config/rofi/scripts/keybinds.py

# Clipboard history (pick an entry to copy it again)
super + v
    rofi -modi "clipboard:greenclip print" -show clipboard -run-command '\{cmd\}'

# Switch window (hold Alt, tap Tab to move down, release Alt to pick)
alt + Tab
    rofi -show window -selected-row 1 -kb-cancel "Alt+Escape,Escape" -kb-accept-entry "!Alt+Alt_L,Return" -kb-row-down "Alt+Tab,Alt+Down,Down" -kb-row-up "Alt+Shift+ISO_Left_Tab,Alt+Up,Up" -kb-element-next "" -kb-element-prev ""

## Screenshots

# Screenshot: select region, annotate, copy or save
Print
    flameshot gui

# Screenshot: full screen to ~/Pictures/Screenshots
super + Print
    flameshot full --path ~/Pictures/Screenshots

## Session

# Lock screen
super + shift + x
    ~/.config/rofi/scripts/lock.sh

# Power Mode: Performance / Balanced / Power Saver
super + p
    ~/.config/rofi/scripts/powerprofile.sh

# Power menu: lock, suspend, log out, reboot, shut down
super + x
    ~/.config/rofi/scripts/powermenu.sh

# Reload bspwm config
super + alt + r
    bspc wm -r

# Quit bspwm (log out)
super + alt + q
    bspc quit

# Reload keybindings
super + Escape
    pkill -USR1 -x sxhkd

## Media keys

# Volume up / down (capped at 100%: above that PipeWire amplifies and distorts)
XF86Audio{Raise,Lower}Volume
    wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%{+,-}

# Media: play/pause, next, previous, stop (Spotify, browsers, …)
XF86Audio{Play,Pause,Next,Prev,Stop}
    playerctl {play-pause,play-pause,next,previous,stop}

# Mute speakers
XF86AudioMute
    pactl set-sink-mute @DEFAULT_SINK@ toggle

# Mute microphone
XF86AudioMicMute
    pactl set-source-mute @DEFAULT_SOURCE@ toggle

# Brightness up / down
XF86MonBrightness{Up,Down}
    ~/.config/bspwm/brightness.sh {up,down}

## Windows

# Close window
super + q
    bspc node -c

# Kill window (force)
super + shift + q
    bspc node -k

# Tiled
super + t
    bspc node -t tiled

# Toggle pseudo-tiled (keeps its own size inside the tile)
super + shift + t
    bspc node -t '~pseudo_tiled'

# Toggle fullscreen (press again to go back)
super + f
    bspc node -t '~fullscreen'

# Toggle floating (press again to tile it again)
super + shift + f
    bspc node -t '~floating'

# Maximize / restore, like tmux prefix+z (monocle: keeps gaps, bar and rounded corners)
super + {m,z}
    bspc desktop -l next

# Focus window left / down / up / right
super + {h,j,k,l}
    bspc node -f {west,south,north,east}

# Focus window (arrow keys)
super + {Left,Down,Up,Right}
    bspc node -f {west,south,north,east}

# Swap window left / down / up / right
super + shift + {h,j,k,l}
    bspc node -s {west,south,north,east}

# Swap window (arrow keys)
super + shift + {Left,Down,Up,Right}
    bspc node -s {west,south,north,east}

# Focus next / previous window
super + {comma,period}
    bspc node -f {next,prev}.local.!hidden.window

# Grow window left / down / up / right
super + alt + {h,j,k,l}
    bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# Shrink window left / down / up / right
super + alt + shift + {h,j,k,l}
    bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# Move floating window
super + ctrl + {Left,Down,Up,Right}
    bspc node -v {-20 0,0 20,0 -20,20 0}

# Rotate the desktop layout 90°
super + r
    bspc node @/ -R 90

## Split
# (preselect where the next window opens)

# Preselect left / down / up / right
super + ctrl + {h,j,k,l}
    bspc node -p {west,south,north,east}

# Preselect split ratio 10%–90%
super + ctrl + {1-9}
    bspc node -o 0.{1-9}

# Cancel preselection
super + ctrl + space
    bspc node -p cancel

## Desktops

# Go to desktop 1–10 (Super+1 → first desktop, Super+0 → desktop 10)
super + {1-9,0}
    bspc desktop -f '{1-9,10}'

# Move window to desktop 1–10 (Super+Shift+3 → desktop 3, Super+Shift+0 → 10)
super + shift + {1-9,0}
    bspc node -d '{1-9,10}'

# Previous / next desktop
super + bracket{left,right}
    bspc desktop -f {prev,next}.local

# Send window to previous / next desktop
super + shift + bracket{left,right}
    bspc node -d {prev,next}.local

# Last used desktop
super + Tab
    bspc desktop -f last
